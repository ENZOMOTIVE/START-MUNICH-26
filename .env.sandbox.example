# Sandbox environment. Copy to .env.sandbox (git-ignored). Every value here is synthetic.
# The sandbox never reads .env, and it refuses to start if any value below points at a real
# service or looks like a real credential (see backend/app/core/config.py).

APP_MODE=sandbox
LIVE_ACTIONS_ENABLED=false
LLM_MODE=fake
SIMULATION_SEED=42
ROUTER_BACKEND=keyword

# Own database, own port, own volume. Nothing is shared with the demo or live stack.
POSTGRES_USER=fiveu_sandbox
POSTGRES_PASSWORD=fiveu_sandbox
POSTGRES_DB=fiveu_sandbox
DATABASE_URL=postgresql+psycopg://fiveu_sandbox:fiveu_sandbox@127.0.0.1:5434/fiveu_sandbox

API_HOST=127.0.0.1
API_PORT=8100
FRONTEND_ORIGIN=http://127.0.0.1:5174

# `sandbox.invalid` never resolves. The simulator answers these paths in memory.
HACKATHON_API_BASE=https://sandbox.invalid
HACKATHON_GATEWAY_BASE=https://sandbox.invalid/v1/gateway
HACKATHON_API_KEY=sandbox-not-a-real-key
GATEWAY_OPENAI_KEY=
TEAM_MAILBOX=free-candy@hackloop.mail
