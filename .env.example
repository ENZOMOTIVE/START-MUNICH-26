# Copy to .env locally (git-ignored). make setup will not overwrite an existing .env.
# Never commit the real keys.
APP_MODE=demo
LIVE_ACTIONS_ENABLED=false

POSTGRES_USER=fiveu
POSTGRES_PASSWORD=fiveu
POSTGRES_DB=fiveu
DATABASE_URL=postgresql+psycopg://fiveu:fiveu@127.0.0.1:5433/fiveu

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Official competition API. https://api.start-hack.5u.ai/docs
HACKATHON_API_BASE=https://api.start-hack.5u.ai
HACKATHON_API_KEY=

# Never put team keys in the frontend bundle. Server-side only.
GATEWAY_OPENAI_KEY=

# --- T2 pricing module (pricing/*) reads these ---
HACK_API_KEY=your-team-api-key-here
HACK_BASE_URL=https://api.start-hack.5u.ai
HACK_MAILBOX=your-team-mailbox@example
