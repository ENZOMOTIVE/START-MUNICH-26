# Copy to .env locally (git-ignored). make setup will not overwrite an existing .env.
# Never commit the real keys.
APP_MODE=demo
LIVE_ACTIONS_ENABLED=false

POSTGRES_USER=fiveu
POSTGRES_PASSWORD=fiveu
POSTGRES_DB=fiveu
DATABASE_URL=postgresql+psycopg://fiveu:fiveu@127.0.0.1:5433/fiveu

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Team FREE CANDY kit. Copy real values into .env — never commit HACKATHON_API_KEY.
# Send the key as header X-API-Key (or Authorization: Bearer).
# Docs: https://api.start-hack.5u.ai/docs
HACKATHON_API_BASE=https://api.start-hack.5u.ai
HACKATHON_API_KEY=
TEAM_MAILBOX=free-candy@hackloop.mail
HACKATHON_DOCS_URL=https://api.start-hack.5u.ai/docs
HACKATHON_PORTAL_URL=https://start-hack.5u.ai/portal/ui
HACKATHON_BOARD_URL=https://api.start-hack.5u.ai/board
HACKATHON_GATEWAY_BASE=https://api.start-hack.5u.ai/v1/gateway

# Optional: POST /v1/gateway/openai-key with {"api_key": "sk-..."} then leave this empty.
GATEWAY_OPENAI_KEY=
