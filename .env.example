# Copy to .env locally. make setup will not overwrite an existing .env.
APP_MODE=demo
LIVE_ACTIONS_ENABLED=false

POSTGRES_USER=fiveu
POSTGRES_PASSWORD=fiveu
POSTGRES_DB=fiveu
DATABASE_URL=postgresql+psycopg://fiveu:fiveu@127.0.0.1:5433/fiveu

API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Official competition API. Live adapters are stubs until T1 verifies this contract.
# https://api.start-hack.5u.ai/docs
HACKATHON_API_BASE=https://api.start-hack.5u.ai
HACKATHON_API_KEY=

# Never put team keys in the frontend bundle. Server-side only.
GATEWAY_OPENAI_KEY=
